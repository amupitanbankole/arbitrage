# =============================================================================
#  TLS listener — TEMPLATE, not loaded by default
# =============================================================================
#  To enable:
#    1. Put a full-chain certificate and its key in
#       infrastructure/docker/nginx/ssl/ (git-ignored by extension).
#    2. Copy this file to conf.d/10-tls.conf so nginx actually loads it.
#    3. Mount ./nginx/ssl and publish 443 in docker-compose.yml.
#
#  It is a template rather than an active file because an nginx that references
#  a certificate which is not mounted fails to start, and a stack that cannot
#  start in a fresh clone is worse than one that starts on port 80 and documents
#  how to add TLS.
#
#  Certificate provisioning is deliberately out of scope here: on a single VPS
#  certbot (or a provider's DNS-01 challenge) writes the files, and this
#  listener consumes them. Doing ACME inside nginx would require a module the
#  stock image does not have.
# =============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # TLS 1.2 as the floor: 1.0/1.1 are deprecated by every browser and by
    # PCI-DSS, and 1.3-only would break older monitoring agents.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS lives here and nowhere else. It is a property of a TLS listener:
    # sending it over plain HTTP is ignored by browsers, and sending it from a
    # development instance would pin a browser to HTTPS for a domain it does not
    # own for two years (§87).
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    location / {
        proxy_pass http://arbitrage_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header X-Request-ID $http_x_request_id;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location = /metrics {
        return 404;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        return 404;
    }
}

# Once TLS is live, plain HTTP exists only to redirect. Serving content over
# both would allow a downgrade; a 308 preserves the method on the redirect.
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    # Kept before the redirect so the compose healthcheck still passes.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 308 https://$host$request_uri;
    }
}
