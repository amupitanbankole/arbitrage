# =============================================================================
#  DEVELOPMENT OVERRIDES  —  loaded after .env.example / .env
# =============================================================================
#  These values are NOT secrets: they are deterministic, obviously-fake
#  development defaults safe to commit (§89). arb_core.config refuses to start
#  with any of these values when ENVIRONMENT=production.
#
#  Real local credentials belong in `.env`, which is git-ignored.
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_FORMAT=console
LOG_LEVEL=DEBUG

# Service hostnames match docker-compose service names.
DATABASE_URL=postgresql+asyncpg://arbitrage:dev_only_not_a_secret@localhost:5432/arbitrage
DATABASE_MIGRATION_URL=postgresql+psycopg://arbitrage:dev_only_not_a_secret@localhost:5432/arbitrage
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=arb_dev

INTERNAL_API_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

JWT_SECRET=dev_only_insecure_jwt_secret_do_not_use_anywhere_else_0123456789abcdef
SESSION_SECRET=dev_only_insecure_session_secret_do_not_use_anywhere_else_0123456789abc
# Valid url-safe base64 32-byte Fernet key, generated for development only.
ENCRYPTION_KEY=db4D7xAh6Dn9sk-oUr0U2mQ_uGYIxZmxIKFF53hShKA=

EMAIL_PROVIDER=none
LIVE_TRADING_ENABLED=false
METRICS_ENABLED=true
