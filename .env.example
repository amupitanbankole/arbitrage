# =============================================================================
#  ARBITRAGE PLATFORM — CANONICAL ENVIRONMENT TEMPLATE
# =============================================================================
#  Copy to `.env` for local development:      cp .env.example .env
#  Or generate cryptographically strong values:  make secrets
#
#  RULES (§89, §90, §133):
#    * Every placeholder below marked CHANGE_ME MUST be replaced in any
#      deployed environment. The application refuses to start in production
#      with an insecure or default value (see arb_core.config).
#    * Never commit a populated `.env`. Only this template is tracked.
#    * Secrets are injected from the environment / secret manager — never
#      hard-coded, never logged, never returned by the API.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------
# One of: development | test | staging | production
ENVIRONMENT=development
SERVICE_NAME=arbitrage-platform
# Displayed in /health and the UI. Overridden at build time in Docker images.
APP_VERSION=0.1.0
# DEBUG must be false in staging/production. It is validated at startup.
DEBUG=false

# -----------------------------------------------------------------------------
# 2. LOGGING (§66, §127)
# -----------------------------------------------------------------------------
# json  -> structured single-line JSON (production, machine-parseable)
# console -> human-readable coloured output (local development)
LOG_FORMAT=json
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Master switch for secret redaction. There is no supported reason to disable
# this; it exists for forensic debugging only and is force-enabled in production.
LOG_REDACTION_ENABLED=true

# -----------------------------------------------------------------------------
# 3. HTTP SERVER
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Set true when running behind nginx so X-Forwarded-For/Proto are trusted.
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=*
# Public, browser-facing origin of the API (used for OpenAPI + CORS docs).
API_BASE_URL=http://localhost:8000
# Public origin of the Next.js frontend.
FRONTEND_URL=http://localhost:3000
# Server-side origin used by the Next.js container to reach the API. Inside
# docker-compose this is the service name, NOT localhost (§ preview/networking).
INTERNAL_API_URL=http://api:8000
# Comma-separated list of allowed browser origins (§61).
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# 4. POSTGRESQL  (source of truth for all financial data — §64)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://arbitrage:CHANGE_ME_db_password@localhost:5432/arbitrage
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
# Alembic uses a sync driver for offline/online migration support.
DATABASE_MIGRATION_URL=postgresql+psycopg://arbitrage:CHANGE_ME_db_password@localhost:5432/arbitrage

# Values consumed by the postgres container in docker-compose only.
POSTGRES_DB=arbitrage
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=CHANGE_ME_db_password

# -----------------------------------------------------------------------------
# 5. REDIS  (cache / pubsub / locks / queues — never authoritative — §64)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
# Namespaces every key so multiple environments can share one Redis safely.
REDIS_KEY_PREFIX=arb
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# 6. SECURITY — AUTHENTICATION (§59, §60)
# -----------------------------------------------------------------------------
# HS256 signing key. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_jwt_secret_min_64_chars_long_random_string_aaaaaaaaaaaaaaaaaaaa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Absolute lifetime of a server-side session record.
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=30
# Used to sign/encrypt session and CSRF material. Distinct from JWT_SECRET.
SESSION_SECRET=CHANGE_ME_session_secret_min_64_chars_long_random_string_aaaaaaaaaaaaaaaa

# -----------------------------------------------------------------------------
# 7. SECURITY — PASSWORD HASHING (§3, §59)
# -----------------------------------------------------------------------------
# argon2id (recommended) | bcrypt
PASSWORD_HASH_SCHEME=argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=12

# -----------------------------------------------------------------------------
# 8. SECURITY — CREDENTIAL ENCRYPTION (§12)
# -----------------------------------------------------------------------------
# Envelope master key used to encrypt exchange API secrets at rest.
# MUST be a url-safe base64-encoded 32-byte key. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotating this key requires re-encrypting all stored credentials (§85).
# The value below is the well-known DEVELOPMENT key derived from a public
# string. It is valid Fernet format so local dev works out of the box, and
# arb_core.config rejects it outright when ENVIRONMENT=production.
ENCRYPTION_KEY=db4D7xAh6Dn9sk-oUr0U2mQ_uGYIxZmxIKFF53hShKA=
# Additional authenticated-encryption context bound into every ciphertext so a
# value encrypted for one tenant/environment cannot be replayed into another.
ENCRYPTION_CONTEXT=arbitrage-platform

# -----------------------------------------------------------------------------
# 9. SECURITY — COOKIES / CSRF (§61)
# -----------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
# lax | strict | none  ("none" requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# 10. RATE LIMITING (§61, §76)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Default bucket applied to unauthenticated endpoints.
RATE_LIMIT_DEFAULT=120/minute
# Stricter bucket for credential-checking endpoints (§59 brute-force protection).
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ADMIN=60/minute

# -----------------------------------------------------------------------------
# 11. TRADING SAFETY DEFAULTS (§31, §32)
# -----------------------------------------------------------------------------
# Live trading is DISABLED by default and can only be enabled per-bot through an
# explicit, audited, permission-gated activation flow. This flag is the global
# master gate: when false, no live order can be submitted anywhere in the system.
LIVE_TRADING_ENABLED=false
# Intentionally conservative first-live-trade limits (§32). Never silently raised.
DEFAULT_MAX_TRADE_USD=25
DEFAULT_MAX_DAILY_LOSS_USD=25
DEFAULT_MAX_CONCURRENT_TRADES=1
DEFAULT_MAX_EXCHANGE_EXPOSURE_USD=100
# Platform-wide emergency stop. When true no new orders are submitted and
# existing orders enter controlled reconciliation (§26).
GLOBAL_KILL_SWITCH_ENABLED=false
# Maximum age of market data before it is considered stale and unusable (§79).
MARKET_DATA_MAX_AGE_MS=2000
# Default opportunity time-to-live (§80).
OPPORTUNITY_TTL_SECONDS=5

# -----------------------------------------------------------------------------
# 12. NOTIFICATIONS (§56)
# -----------------------------------------------------------------------------
# none | smtp | ses
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_STARTTLS=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
TELEGRAM_DEFAULT_CHAT_ID=

# -----------------------------------------------------------------------------
# 13. OBSERVABILITY (§54, §112)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Protect /metrics with a static bearer token. Leave empty to allow unauthenticated
# scraping from the internal network only.
METRICS_AUTH_TOKEN=
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# 14. WORKERS (§55)
# -----------------------------------------------------------------------------
# Comma-separated roles this process should run.
WORKER_ROLES=foundation
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# A worker is considered missing after this many seconds without a heartbeat.
WORKER_STALE_AFTER_SECONDS=60
WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 15. FEATURE FLAGS — ENVIRONMENT OVERRIDES (§58)
# -----------------------------------------------------------------------------
# Database rows are authoritative; these are bootstrap defaults only.
FEATURE_FLAG_PAPER_TRADING=true
FEATURE_FLAG_LIVE_TRADING=false
FEATURE_FLAG_BACKTESTING=false
FEATURE_FLAG_DEX_TRADING=false
FEATURE_FLAG_REBALANCING=false
FEATURE_FLAG_ADVANCED_EXECUTION=false

# -----------------------------------------------------------------------------
# 16. FRONTEND (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Arbitrage Platform
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# 17. MONITORING STACK CREDENTIALS (docker-compose only)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
