# =============================================================================
#  TEST OVERRIDES
# =============================================================================
#  Tests never touch a real exchange and never use production data (§142, §143).
#
#  Database / Redis strategy:
#    * By default the suite runs against SQLite (via aiosqlite) and fakeredis so
#      it is hermetic and needs no services.
#    * Set TEST_DATABASE_URL / TEST_REDIS_URL to point at real PostgreSQL/Redis;
#      the `postgres` and `redis_server` marked tests then activate. CI and
#      docker-compose provide real services, so those paths are exercised there.
# =============================================================================
ENVIRONMENT=test
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=WARNING

TEST_DATABASE_URL=sqlite+aiosqlite:///./tmpfiles/test.db
TEST_DATABASE_ECHO=false
TEST_REDIS_URL=

DATABASE_URL=sqlite+aiosqlite:///./tmpfiles/test.db
DATABASE_MIGRATION_URL=sqlite:///./tmpfiles/test.db
REDIS_URL=redis://localhost:6379/15
REDIS_KEY_PREFIX=arb_test

JWT_SECRET=test_only_insecure_jwt_secret_do_not_use_anywhere_else_0123456789abcdef
SESSION_SECRET=test_only_insecure_session_secret_do_not_use_anywhere_else_012345678
ENCRYPTION_KEY=9b4jVmYWQwDDmHYJcNY1Izm4O9GVGhbAIF7zv0VR4tM=

# Safety defaults are asserted in tests; keep them identical to production
# defaults so a test that passes locally behaves the same in CI.
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH_ENABLED=false
RATE_LIMIT_ENABLED=false
METRICS_ENABLED=true
EMAIL_PROVIDER=none
