# =============================================================================
#  PRODUCTION TEMPLATE  —  copy to `.env.production` and fill in from your
#  secret manager.  NEVER commit the populated file.
# =============================================================================
#  The application performs a hard startup validation in production
#  (arb_core.config.Settings.validate_production). It will REFUSE TO BOOT if:
#    * DEBUG is true
#    * any secret is missing, a placeholder, or a known development value
#    * ENCRYPTION_KEY / JWT_SECRET / SESSION_SECRET are shorter than required
#    * COOKIE_SECURE is false
#    * CORS_ORIGINS contains a wildcard together with credentials
#    * DATABASE_URL points at SQLite
#  This is intentional: a misconfigured trading system must fail closed (§145).
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_FORMAT=json
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true
# Accept forwarded headers only from the reverse proxy. The API port must not
# be published to the host (§124); if that ever changes this MUST be narrowed.
FORWARDED_ALLOW_IPS=*

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
INTERNAL_API_URL=http://api:8000
CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=true

DATABASE_URL=postgresql+asyncpg://arbitrage:REPLACE_WITH_SECRET_MANAGER_VALUE@postgres:5432/arbitrage
DATABASE_MIGRATION_URL=postgresql+psycopg://arbitrage:REPLACE_WITH_SECRET_MANAGER_VALUE@postgres:5432/arbitrage
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=arb_prod

JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
SESSION_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ENCRYPTION_CONTEXT=arbitrage-platform

PASSWORD_HASH_SCHEME=argon2id
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.example.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ADMIN=60/minute

# ---- Trading safety: production starts fully gated (§31, §32, §48) ----------
LIVE_TRADING_ENABLED=false
GLOBAL_KILL_SWITCH_ENABLED=false
DEFAULT_MAX_TRADE_USD=25
DEFAULT_MAX_DAILY_LOSS_USD=25
DEFAULT_MAX_CONCURRENT_TRADES=1
DEFAULT_MAX_EXCHANGE_EXPOSURE_USD=100

EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=REPLACE
SMTP_PORT=587
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
SMTP_STARTTLS=true
TELEGRAM_BOT_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=REPLACE_WITH_STATIC_BEARER_TOKEN
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

WORKER_ROLES=foundation
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60

FEATURE_FLAG_LIVE_TRADING=false
FEATURE_FLAG_DEX_TRADING=false
FEATURE_FLAG_REBALANCING=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
